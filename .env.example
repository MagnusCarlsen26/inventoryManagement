# Copy to .env.dev / .env.production and fill in per environment.
# Only PUBLIC values belong here (Supabase project URL + anon/publishable key).
# The service_role key and any real secret must NEVER go in these files.
# ADMIN_PASSWORD is POC-only: it is bundled into the app and can be extracted.
SUPABASE_URL=
SUPABASE_ANON_KEY=
ADMIN_PASSWORD=
